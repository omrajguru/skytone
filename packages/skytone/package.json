{
  "name": "skytone",
  "version": "0.1.0",
  "description": "A living watercolour sky for any interface. Real sun and moon positions, the live forecast, and a soft WebGL renderer, with no dependencies.",
  "keywords": [
    "sky",
    "weather",
    "watercolor",
    "webgl",
    "background",
    "sunrise",
    "sunset",
    "forecast",
    "generative",
    "canvas"
  ],
  "homepage": "https://skytone.site",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omrajguru/skytone.git",
    "directory": "packages/skytone"
  },
  "bugs": {
    "url": "https://github.com/omrajguru/skytone/issues"
  },
  "author": "Om Rajguru (https://github.com/omrajguru)",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3"
  }
}
